// AutoRoom API — initial schema (A0).
//
// Scope is Phase A's foundation from references/admin.md: users, the
// data-driven role/permission matrix, grouped settings with an audit trail, and
// the two reference tables the seed needs (branches, banks). The domain models
// — Car, Lead, Order and the rest — arrive with their own migrations in Phases
// B–D; migrations are the source of truth, so nothing here is edited in place
// once it has shipped.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  PUBLISH
}

enum SettingGroup {
  BRANDING
  CONTACTS
  FINANCE
  FEATURES
  LOCALIZATION
}

/// A named bundle of permissions. Seeded with the five roles from admin.md A2,
/// but editable at runtime by super_admin — hence a table rather than an enum.
model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  /// Seeded roles the UI must not let anyone delete or rename.
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

/// One `resource × action` pair. The catalogue is generated from
/// src/rbac/permissions.ts, so the code and the rows cannot drift apart.
model Permission {
  id       String           @id @default(cuid())
  resource String
  action   PermissionAction

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Back-office and partner-portal accounts. Public site visitors are never
/// users — their submissions become Leads (Phase C).
model User {
  id String @id @default(cuid())

  /// Stored lower-cased; the application normalises before writing so the
  /// unique index is effectively case-insensitive.
  email        String     @unique
  passwordHash String
  name         String
  status       UserStatus @default(PENDING)
  lastLoginAt  DateTime?

  /// Set on a system-issued password (partner portal invites today) and
  /// cleared by `POST /auth/change-password`. The client gates the rest of
  /// the panel behind that screen while this is true.
  mustChangePassword Boolean @default(false)

  /// Consecutive failed logins; reset to 0 on success.
  failedLoginAttempts Int       @default(0)
  /// Set when `failedLoginAttempts` crosses the threshold. Login is refused
  /// until this passes, regardless of whether the password is correct.
  lockedUntil         DateTime?

  /// Null while `status` is PENDING: a self-registered user has no role until an
  /// admin approves and assigns one (admin.md A1). Enforced in code rather than
  /// by the database, since the two columns constrain each other.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Set when this account is a partner's portal login.
  partner Partner?

  updatedSettings     Setting[]
  auditEntries        AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
  @@map("users")
}

/// A refresh-token grant. The token itself is opaque high-entropy random bytes
/// that only ever reach the client; the database stores its SHA-256, so a dump
/// of this table cannot be replayed against the API.
///
/// Rotation: each refresh revokes the presented token and issues a successor,
/// linked through `replacedById`. Presenting an already-revoked token means it
/// leaked and is being replayed, so the whole family is revoked at once.
model RefreshToken {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  expiresAt    DateTime
  revokedAt    DateTime?
  /// The token issued when this one was rotated.
  replacedById String?

  /// Context for the sessions list an admin can review later.
  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Single-use password reset grant. Hashed at rest for the same reason as
/// refresh tokens, and consumed by setting `usedAt`.
model PasswordResetToken {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Grouped, typed settings read by both the admin and (as a filtered subset)
/// the public site. One row per setting key; the value is JSON so a group can
/// gain fields without a migration.
model Setting {
  key   String       @id
  group SettingGroup

  valueJson Json

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

/// Who changed what, when. admin.md requires this for settings changes, role
/// changes and order-stage advances, so it is generic rather than per-resource.
model AuditLog {
  id String @id @default(cuid())

  /// Null for system actions such as the seed.
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// Dotted verb, e.g. `setting.update`, `role.permissions.update`.
  action     String
  resource   String
  resourceId String?
  /// Enough of the before/after to reconstruct the change.
  dataJson   Json?

  createdAt DateTime @default(now())

  @@index([resource, resourceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

/// The physical branches. Also surfaced in Settings (admin.md A4) but owns its
/// own table, since the public BranchMap reads it as a collection.
model Branch {
  id       String  @id @default(cuid())
  name     String
  city     String
  address  String
  phone    String
  hours    String
  lat      Float?
  lng      Float?
  mapUrl   String?
  photoUrl String?
  /// Display order on the public site.
  position Int     @default(0)

  slots AvailabilitySlot[]
  /// Leads whose booked meeting is at this office — the "Become a dealer"
  /// form's `🏢 AutoRoom գրասենյակում` choice.
  meetingLeads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

/// Which FAQ a question belongs to.
///
/// `references/admin.md` names only china and usa. `GENERAL` is added for the
/// answered set in `references/faq.md` that belongs to neither — how payment is
/// staged, how the contract is signed, where the branches are. Filing those
/// under CHINA would make the USA page either repeat them or lose them.
enum FaqTopic {
  CHINA
  USA
  GENERAL
}

/// A question and its answer — Homepage S9, and the China/USA page sections.
///
/// `question` and `answer` are JSON, not `String`, because a question can be
/// written in more than one of the site's languages (see `LOCALIZATION`
/// settings): `{ "hy": "...", "ru": "...", "en": "..." }`. Armenian (`hy`) is
/// the one language every row must carry — it's the site's default and only
/// guaranteed-enabled locale; `ru`/`en` are filled in as translations land.
///
/// The answer is nullable because that is the real state of this content: the
/// spec lists ten China questions whose answers the content team has not
/// written yet, and a screen that cannot hold a question without an answer
/// would force someone to invent one. Publishing is what requires both — and
/// specifically requires the Armenian answer, since that is the locale the
/// site is guaranteed to serve.
model Faq {
  id       String   @id @default(cuid())
  topic    FaqTopic
  question Json
  answer   Json?

  /// Display order within a topic.
  position    Int       @default(0)
  /// Null means draft — the public endpoint never returns it.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topic, position])
  @@map("faq")
}

/// What a piece of video is for. The Story Wall reads `CUSTOMER_STORY`; the
/// homepage founder film and the guide reels share the table because they are
/// the same thing to an editor — a titled video with a poster frame.
enum MediaKind {
  FOUNDER
  CUSTOMER_STORY
  GUIDE_REEL
}

/// Video the marketing site plays — `references/admin.md` calls this Media.
///
/// The spec parks the kind-specific fields in a `meta` JSON blob. The customer
/// story fields are real columns instead: they are a known, fixed set that the
/// Story Wall renders and the admin form validates, and a blob can be neither
/// validated by the database nor filtered on. They are nullable because a
/// founder film has no "why they chose us".
model Media {
  id        String    @id @default(cuid())
  kind      MediaKind
  title     String
  videoUrl  String
  /// Still frame shown before play. Without one a video wall is a grid of black.
  posterUrl String?

  /**
   * ---- customer story ----
   */
  customerName String?
  /// Free text, not a Car relation: the story outlives the listing, and most of
  /// these cars were delivered long before the catalogue existed.
  carLabel     String?
  origin       CarOrigin?
  whyChosen    String?
  experience   String?

  /// Display order within a kind.
  position    Int       @default(0)
  /// Null means draft — the public endpoint never returns it.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, position])
  @@map("media")
}

/// Financing partners behind the "Գնել Վարկով" grid. `inHouse` marks AutoRoom's
/// own offer, which opens in place instead of linking out.
model Bank {
  id       String  @id @default(cuid())
  name     String  @unique
  logoUrl  String?
  loanUrl  String?
  inHouse  Boolean @default(false)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banks")
}

/// The "Մեր թիմը" grid on the About page — one card per person, `position`
/// controls display order. `linkedinUrl` is optional per the Figma card,
/// which only shows the icon for people who have one.
model TeamMember {
  id          String  @id @default(cuid())
  name        String
  title       String
  photoUrl    String?
  linkedinUrl String?
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

/// The photo collage on the About page's S4 section, right below the team
/// grid (`PhotoGallery` in apps/web) — `position` controls display order.
/// Every row here is a real tile; the collage renders exactly this set
/// (sorted by `position`) and disappears from the page entirely when empty,
/// same "no placeholder content" contract as `TeamMember`.
model GalleryImage {
  id       String @id @default(cuid())
  imageUrl String
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery_images")
}

/**
 * ------------------------------- catalogue (B1) ------------------------------
 */

enum CarOrigin {
  CHINA
  USA
}

/// Where the car is in its journey. Drives which CTA the public site offers:
/// IN_STOCK goes to a detail page, AUCTION to the auction flow.
enum CarCondition {
  IN_STOCK
  ON_ORDER
  ON_ROAD
  AUCTION
}

/// Optional shipping marker shown as a badge on the card.
enum CarStatusBadge {
  NA_NAVUM
  POTI
  CUSTOMS
}

enum Powertrain {
  EV
  HYBRID
  BENZIN
}

/// Which auction house an `AUCTION` car's listing is on — drives the USA
/// "best auctions" S2.1 filter tabs (Բոլորը/Copart Deal/IAAI Deal/Manheim
/// Deal). Null for every non-`AUCTION` car, same optional-until-set contract
/// as `auctionViewUrl`.
enum AuctionPlatform {
  COPART
  IAAI
  MANHEIM
}

/// Photo groupings from admin.md. AUCTION and RECEIPT are captured during
/// import; HANDOVER is uploaded by staff in Gyumri when the container opens.
enum ImageAlbum {
  EXTERIOR
  INTERIOR
  DETAILS
  VIDEO
  AUCTION
  RECEIPT
  HANDOVER
}

model Car {
  id   String @id @default(cuid())
  /// URL segment on the public site. Unique so a car has one canonical address.
  slug String @unique

  origin CarOrigin
  make   String
  model  String
  year   Int
  trim   String?

  powertrain   Powertrain
  /// Kilometres on a full charge — EV and hybrid only.
  range        Int?
  /// Pack size, e.g. "77 kWh".
  battery      String?
  engine       String?
  drivetrain   String?
  transmission String?
  seats        Int?
  warranty     String?

  vin       String?
  lotNumber String?
  mileage   Int?
  /// The AutoRoom-provided View-Only (Guest Login) link a visitor follows to
  /// watch this specific Copart/IAAI listing live — USA auction detail S2.3's
  /// "Տեսնել մեքենան օնլայն" CTA. Null for every non-`AUCTION` car, and for
  /// an auction car until staff attach it; the button itself is skipped
  /// while unset, same "field renders nothing until set" contract as every
  /// other optional column here (see `CarSpecs`).
  auctionViewUrl String?
  /// Set alongside `auctionViewUrl` for an `AUCTION` car — see
  /// `AuctionPlatform`'s own comment.
  auctionPlatform AuctionPlatform?

  /// Whole currency units, not minor: AutoRoom quotes round figures and the
  /// public site never renders cents.
  price           Int
  oldPrice        Int?
  /// Estimated final price delivered in Armenia.
  estFinalPriceAM Int?
  /// Set alongside `oldPrice` to run this car as a time-limited "Ակցիա" on
  /// the /offers page — a countdown while in the future, a grayscale
  /// "Ավարտված" card once past. Null means this car is never a promotion,
  /// regardless of `oldPrice` (a struck-through price with no deadline is
  /// just a permanent discount, not a promo).
  promoDeadline   DateTime?

  condition          CarCondition
  statusBadge        CarStatusBadge?
  deliveryEtaDays    Int?
  location           String?
  damageHistory      String?
  financingAvailable Boolean         @default(true)
  featured           Boolean         @default(false)

  /// `[{ name, hex, imageUrl? }]`. Only meaningful for ON_ORDER cars — an
  /// in-stock car is one specific car in one specific colour.
  colors       Json @default("[]")
  /// `[{ label, amount, note? }]` — the four chips breaking down the price.
  priceJourney Json @default("[]")

  /// Null means draft: the public read API never returns it.
  publishedAt DateTime?

  /// The partner this car is assigned to, if any. Drives what they see in the
  /// portal; null means it belongs to nobody in particular.
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  images   CarImage[]
  bookings Booking[]

  /// Admin-curated "Նմանատիպ առաջարկներ" for this car, ordered by
  /// `CarSimilar.position`. The public China car-detail page falls back to
  /// an automatic same-origin/powertrain/price-distance match
  /// (`apps/web/lib/cars.ts`'s `listSimilarCars`) when this is empty.
  similarAsSource CarSimilar[] @relation("CarSimilarSource")
  /// Reverse side — which cars list *this* car as one of their curated
  /// picks. Not surfaced anywhere; exists only so a deleted car cascades out
  /// of every other car's list rather than leaving a dangling row.
  similarAsTarget CarSimilar[] @relation("CarSimilarTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
  @@index([origin, condition])
  @@index([featured])
  @@index([publishedAt])
  @@map("cars")
}

/// A car's admin-curated "similar offers" list. One row per (car, pick) —
/// directional and hand-ordered, not the automatic symmetric relation an
/// implicit many-to-many would give: an admin picks *this* car's similar
/// cars explicitly, and picking A→B does not imply B→A.
model CarSimilar {
  carId        String
  car          Car    @relation("CarSimilarSource", fields: [carId], references: [id], onDelete: Cascade)
  similarCarId String
  similarCar   Car    @relation("CarSimilarTarget", fields: [similarCarId], references: [id], onDelete: Cascade)
  /// Display order within the source car's curated list.
  position     Int    @default(0)

  @@id([carId, similarCarId])
  @@index([similarCarId])
  @@map("car_similar")
}

model CarImage {
  id       String     @id @default(cuid())
  carId    String
  car      Car        @relation(fields: [carId], references: [id], onDelete: Cascade)
  album    ImageAlbum
  url      String
  /// Display order within its album.
  position Int        @default(0)

  createdAt DateTime @default(now())

  @@index([carId, album])
  @@map("car_images")
}

/**
 * -------------------------------- partners (C3) -------------------------------
 */

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// A dealer or agent AutoRoom works with. Their portal login is a normal User
/// carrying the `partner` role; the link is what scopes every portal read to
/// their own records, since a resource×action matrix cannot express "their own".
model Partner {
  id      String  @id @default(cuid())
  name    String
  company String?
  phone   String?
  email   String?
  notes   String?

  /// The portal account. Optional: a partner can exist in the CRM before
  /// anyone gives them a login, and revoking access should not delete them.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  /// Set when this partner was created by converting a "Become a dealer"
  /// `Lead` (`POST /leads/:id/convert-to-partner`) rather than typed in
  /// directly. Back-relation only — the lead is what points here
  /// (`Lead.convertedPartnerId`), so a lead can convert to at most one
  /// partner and this side never needs its own foreign key.
  convertedFromLead Lead?

  cars     Car[]
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partners")
}

/// A bookable window of showroom time. Slots are what a partner picks from, so
/// "when can I come in" is answered by the rows here rather than by a free-text
/// datetime nobody checked against the diary.
///
/// A slot is *open* while the bookings holding it — cancelled ones excluded —
/// number fewer than `capacity`; otherwise it is *taken*. That count is derived
/// on read rather than stored, so a booking cancelled anywhere frees the slot
/// without a second write that could drift out of step.
model AvailabilitySlot {
  id String @id @default(cuid())

  /// Where the appointment happens. Optional, and `SetNull` on delete: closing a
  /// branch should not silently take the diary with it.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  startsAt DateTime
  endsAt   DateTime

  /// How many bookings the window holds. A branch running two bays sets 2
  /// rather than duplicating the row.
  capacity Int @default(1)

  note String?

  bookings Booking[]
  /// Public "Become a dealer" enquiries that asked for this window. These do
  /// *not* count towards `capacity` — only `bookings` do — see `Lead`.
  meetingLeads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The diary is always read as a date range, usually for one branch.
  @@index([startsAt])
  @@index([branchId, startsAt])
  @@map("availability_slots")
}

/// A viewing or handover appointment. `carId` is optional — a partner can book
/// time before deciding which car it is about.
model Booking {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  carId String?
  car   Car?    @relation(fields: [carId], references: [id], onDelete: SetNull)

  /// The slot this appointment holds, when it was booked from the diary.
  /// Optional: staff can still write an appointment straight into the calendar
  /// for a time nobody published, and `scheduledAt` stays the single answer to
  /// "when" either way — bound to `slot.startsAt` whenever a slot is held.
  slotId String?
  slot   AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  customerName  String?
  customerPhone String?

  scheduledAt DateTime
  status      BookingStatus @default(REQUESTED)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, scheduledAt])
  // Counting what holds a slot is the hot path behind every open/taken read.
  @@index([slotId])
  @@map("bookings")
}

/**
 * -------------------------------- leads (C1) -------------------------------
 */

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

/// Where a booked meeting happens, as the visitor chose it on the "Become a
/// dealer" form (`references/pages.md` §5 S5's three radio cards: 💻 Օնլայն,
/// 🏢 AutoRoom գրասենյակում, 📍 Այլ հասցե).
///
/// A real enum rather than one of `Lead`'s free-text columns because unlike
/// `interest` or `topic` — display labels staff read — the API branches on
/// this: `OFFICE` is the only value that may name a branch and `OTHER` the
/// only one that may carry an address. It is also stored rather than derived
/// from which of those two columns is filled in: `ONLINE` is a choice the
/// visitor positively made, not the absence of the other two, and inferring it
/// from two empty columns would read as missing data on the CRM screen.
enum MeetingFormat {
  ONLINE
  OFFICE
  OTHER
}

/// A submission from any of the public site's lead-capture entry points
/// (`references/components.md`'s Universal popup, Quiz popup, or the Contact
/// page's static form — see `apps/web/lib/leads.ts`'s `LeadPayload`). Every
/// field below except name/phone is optional because each widget asks its
/// own subset of questions; kept as plain strings rather than enums since
/// each caller's own vocabulary differs (the popup's fixed `LeadInterest`
/// chips vs the Contact form's free-form `Թեմա` dropdown) and staff read
/// these as display labels, not codes to branch logic on.
model Lead {
  id String @id @default(cuid())

  name  String
  phone String
  email String?

  topic     String?
  interest  String?
  budget    String?
  financing String?
  timing    String?
  channel   String?
  color     String?
  comment   String?

  /// The "Become a dealer" meeting-booking form's own two contact questions
  /// (`references/pages.md` §5 S5: `Ընկերության անվանում`, `Գործունեության
  /// ոլորտ`). `activityType` is a plain string, not an enum, for the same
  /// reason `interest` and `topic` are: it is the label of whichever dropdown
  /// option the visitor picked, and the design's own five-item list has
  /// already been shortened once from the spec's eight. Staff read it; nothing
  /// branches on it.
  company      String?
  activityType String?

  /// The meeting a visitor asked for on that same form. Nullable as a group —
  /// no other lead-capture widget books a time — but filled in together: the
  /// route refuses a format without a time, or a time without a format.
  ///
  /// Note what this deliberately is *not*: a `Booking`. `references/pages.md`
  /// §5 S5 records this as a Partner Lead "tied to chosen slot", and the
  /// visitor is applying to *become* a partner, so there is no `Partner` row to
  /// hang a `Booking` off and forcing an inactive one into existence would
  /// spread unvetted applicants through the CRM's partner list. A lead
  /// therefore expresses interest in a window without holding it: slot
  /// occupancy stays defined by `Booking` rows alone
  /// (`services/availability.ts`), and a manager converting a promising lead
  /// into a real partner + booking is what actually claims the capacity.
  meetingFormat MeetingFormat?

  /// When the meeting is, and the published window it came from.
  ///
  /// Both are stored for the reason `Booking` stores both: `meetingAt` is the
  /// single answer to "when", and the slot is optional because the form offers
  /// a fixed daily set of times (10:00/11:00/12:30/14:00/15:30/17:00) that may
  /// include a time nobody has generated a slot row for yet. When a slot *is*
  /// named the route binds `meetingAt` to `slot.startsAt` on write, so the two
  /// cannot disagree. `SetNull` on delete: withdrawing a window from the diary
  /// must not delete the enquiry that came through it.
  meetingAt     DateTime?
  meetingSlotId String?
  meetingSlot   AvailabilitySlot? @relation(fields: [meetingSlotId], references: [id], onDelete: SetNull)

  /// Where, for the two formats that need somewhere to be. Exactly one is set:
  /// `meetingBranchId` for `OFFICE`, `meetingAddress` for `OTHER`, neither for
  /// `ONLINE` — enforced in `routes/leads.ts` rather than by a CHECK
  /// constraint, matching how every other cross-field rule in this schema is
  /// held (`endsAt > startsAt`, the FAQ's publish rule).
  ///
  /// This is not a duplicate of `meetingSlot.branchId`: a slot's branch scopes
  /// the *diary*, and the generator happily produces branch-less windows, so
  /// which office the visitor asked for is its own fact. The route rejects the
  /// two contradicting each other.
  meetingBranchId String?
  meetingBranch   Branch? @relation(fields: [meetingBranchId], references: [id], onDelete: SetNull)
  meetingAddress  String?

  /// Set when the lead was opened from a specific car's page/popup.
  carName String?
  carVin  String?
  /// Auction lot number or a pasted link to the specific Copart/IAAI/Manheim
  /// listing — the USA auction contact popup's own field (Figma node
  /// 242:1345's "Մեքենայի հղում կամ լոտի համար"), distinct from `carVin`
  /// since a visitor rarely knows the VIN of a car they haven't bought yet.
  carLink String?

  /// Hidden context every widget attaches automatically (never visitor input).
  sourcePage      String
  sourceCta       String
  locale          String
  device          String
  /// Present only for leads that followed the Quiz flow.
  quizAnswersJson Json?

  status LeadStatus @default(NEW)
  /// Free-text notes a manager leaves while working the lead — distinct from
  /// `comment`, which is what the visitor themselves wrote.
  notes  String?

  /// Set once a manager converts this "Become a dealer" lead into a real
  /// `Partner` + portal login (`POST /leads/:id/convert-to-partner`) — the
  /// step the `meetingFormat` doc comment above calls out as what actually
  /// claims capacity, versus a lead merely expressing interest in a window.
  /// Nullable+unique: most leads are never converted, and a lead backs at
  /// most one partner. `SetNull` on delete: removing the partner later must
  /// not delete the original enquiry that led to them.
  convertedPartnerId String?  @unique
  convertedPartner   Partner? @relation(fields: [convertedPartnerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  // Both foreign keys are indexed explicitly — Postgres indexes the primary key
  // and unique columns for you but never the referencing side, and both of
  // these are `SetNull`, so deleting a slot or a branch scans this table once
  // per row without them.
  @@index([meetingSlotId])
  @@index([meetingBranchId])
  @@map("leads")
}
