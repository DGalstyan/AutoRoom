# Copy to apps/api/.env and fill in. `.env` is git-ignored.

# --- Database -------------------------------------------------------------
# Matches the docker-compose service at the repo root (`npm run db:up`).
DATABASE_URL="postgresql://autoroom:autoroom@localhost:55432/autoroom?schema=public"

# --- Server ---------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
# Comma-separated list of origins allowed to call the API with credentials.
# The admin SPA (Vite, http://localhost:3000, panel mounted at /admin).
CORS_ORIGINS="http://localhost:3000"

# --- Seed -----------------------------------------------------------------
# The first super_admin. If SEED_SUPER_ADMIN_PASSWORD is left empty the seed
# generates a strong random password and prints it once — copy it from the
# output, it is not stored anywhere in plain text.
SEED_SUPER_ADMIN_EMAIL="admin@autoroom.am"
SEED_SUPER_ADMIN_NAME="AutoRoom Admin"
SEED_SUPER_ADMIN_PASSWORD=""

# --- Auth -----------------------------------------------------------------
# Signs access tokens. Minimum 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Refresh tokens need no secret — they are opaque random values stored as a
# SHA-256 hash, so there is nothing to forge.
JWT_ACCESS_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Account lockout after repeated failed logins.
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
PASSWORD_RESET_TTL_MINUTES="60"

# Where password-reset links point — the admin SPA, not the API. Includes the
# /admin base path the panel is served under.
APP_URL="http://localhost:3000/admin"
# Leave unset for host-only cookies; set to share them across subdomains.
# COOKIE_DOMAIN=""

# --- Uploads (Phase B — not read yet) ------------------------------------
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
