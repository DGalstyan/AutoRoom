# Copy to apps/web/.env.local and fill in. `.env*.local` is git-ignored.

# --- Server-side fetches ----------------------------------------------------
# Read-only public data (branding, featured cars, leads, availability, ...)
# fetched from Next's own server code. In docker-compose.prod.yml this points
# at the api container over the internal Docker network; defaults to
# localhost:4000 for local dev against a real apps/api.
# API_INTERNAL_URL="http://localhost:4000"
