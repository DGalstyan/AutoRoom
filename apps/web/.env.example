# Copy to apps/web/.env.local and fill in. `.env*.local` is git-ignored.

# --- Public API (browser-side) ---------------------------------------------
# Base URL the partner portal (`/partners/portal`) calls directly from the
# browser for login/session/dashboard requests — credentials included, so
# this must be an origin apps/api's CORS_ORIGINS allow-lists. Not the same
# thing as API_INTERNAL_URL below: that one is server-only and never reaches
# the client bundle.
#
# NEXT_PUBLIC_ vars are inlined at build time, not read at container start —
# see apps/web/Dockerfile and .github/workflows/deploy.yml, which set this to
# https://admin.autoroom.am/api in production (autoroom.am has no /api of its
# own; only admin.autoroom.am proxies to the API container).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Server-side fetches ----------------------------------------------------
# Read-only public data (branding, featured cars, leads, availability, ...)
# fetched from Next's own server code. In docker-compose.prod.yml this points
# at the api container over the internal Docker network; defaults to
# localhost:4000 for local dev against a real apps/api.
# API_INTERNAL_URL="http://localhost:4000"
