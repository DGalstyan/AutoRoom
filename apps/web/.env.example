# Copy to apps/web/.env.local and fill in. `.env*.local` is git-ignored.
# There are no built-in defaults: a missing value fails loudly instead of quietly pointing at localhost.

# --- Server-side fetches ----------------------------------------------------
# Origin of the API as seen from Next's own server code (branding, cars, leads, ...).
# In docker-compose.prod.yml this is the api container over the internal Docker network.
API_INTERNAL_URL="http://localhost:4000"

# --- Image hosts (build time) -----------------------------------------------
# The API's public origin, including any path prefix (production: https://admin.autoroom.am/api).
# Photos uploaded in the admin are served from `<this>/uploads/**`.
NEXT_PUBLIC_API_URL="http://localhost:4000"
