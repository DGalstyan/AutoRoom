# Copy to apps/admin/.env. Vite only exposes variables prefixed with VITE_.

# Origin of the AutoRoom API. Must be listed in the API's CORS_ORIGINS, and the
# admin sends credentials, so it cannot be a wildcard origin.
VITE_API_URL="http://localhost:4000"

# Origin of the public AutoRoom site, for the car edit form's "View on site" link.
VITE_WEB_URL="http://localhost:3000"
